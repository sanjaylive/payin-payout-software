# Copy to deploy.env at the repo root (git-ignored) and fill in. Read by `npm run deploy`.
# Server: any Linux VPS with Docker Engine + the compose plugin, ports 80/443 open,
# and an A/AAAA record for DOMAIN pointing at it. Use SSH keys, not passwords.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_DIR=/opt/pay2all
DOMAIN=py.2all.co.in

# Edge proxy: "caddy" (this stack owns ports 80/443) or "nginx" (an existing nginx on the server
# proxies to loopback ports; needs passwordless sudo for the vhost and certbot). docs/DEPLOYMENT.md §7.
DEPLOY_PROXY=caddy
# nginx mode only: loopback ports for the API and web (must be free on the server).
API_HOST_PORT=4500
WEB_HOST_PORT=3500
# Deploy refuses to start below this much available memory (MB), to protect other workloads.
DEPLOY_MIN_AVAILABLE_MB=3000

# The image is built by GitHub Actions and pulled from GHCR (default: ghcr.io/<owner>/<repo> of the
# "origin" remote). DOMAIN must match the workflow's PUBLIC_URL (repository variable; default
# https://py.2all.co.in), because that origin is baked into the browser bundle.
# DEPLOY_IMAGE=ghcr.io/sanjaylive/payin-payout-software
# Only while the GHCR package is private: a token with read:packages only, and its user.
# GHCR_PULL_USER=
# GHCR_PULL_TOKEN=
