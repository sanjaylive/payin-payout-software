# Public entry point: automatic HTTPS (Let's Encrypt) for the domain.
# /v1/* → API, everything else → web. Health and metrics endpoints are never exposed.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /v1/* {
		# flush_interval -1: live notifications are streamed.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle /health/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
