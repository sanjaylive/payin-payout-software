# Public entry point: automatic HTTPS (Let's Encrypt) for the domain.
# /v1/* → API, everything else → web. Health and metrics endpoints are never exposed.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /v1/* {
		# flush_interval -1: live notifications are streamed.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle /health/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# AHost (separate stack on this server, /opt/ahost): its api and web containers join this
# stack's internal network as ahost-api / ahost-web. Mirrors deploy/Caddyfile.ahost in that repo.
ahost.in {
	encode zstd gzip

	handle /api/v1/health {
		respond 404
	}

	handle /api/* {
		reverse_proxy ahost-api:4000
	}

	handle {
		reverse_proxy ahost-web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}

www.ahost.in {
	redir https://ahost.in{uri} permanent
}

# hostel.2all.co.in (hostelerp stack) on this stack's Caddy. Its deploy appended this block on the
# server; it is kept here so Pay2All releases do not drop it. Caddy reaches hostel-api/web over
# the pay2all_internal network, which the hostelerp stack joins.
# /api/* goes straight to the API (mobile apps and the web app); health endpoints stay internal.
hostel.2all.co.in {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	handle /api/v1/health* {
		respond 404
	}

	handle /api/* {
		reverse_proxy hostel-api:4000
	}

	handle {
		reverse_proxy hostel-web:3400
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
