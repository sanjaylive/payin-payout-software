// Pay2All Payments — Prisma schema.
// Conventions (docs/DATABASE.md §1): prefixed ULID text PKs generated in the app, BIGINT minor units
// for money, timestamptz(3) UTC, snake_case table/column names, append-only tables guarded by triggers
// declared in migration SQL.
//
// Phase 1 scope: identity & access, sessions, MFA, audit, outbox, notifications.
// Phase 2 scope: merchants, onboarding/KYC, documents, bank accounts, compliance reviews, limits,
// approval policies, sales leads, MFA recovery codes.
// Phase 3 scope: double-entry ledger (accounts, journals, entries, snapshots, adjustments).
// Phase 4 scope: providers, encrypted credentials, routing rules, health snapshots, inbound webhooks.
// Phase 5 scope: payments, attempts, refunds, pricing, idempotency, merchant webhook events.
// Later phases add their models in their own migrations (see docs/ROADMAP.md).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------

enum OrganizationType {
  PLATFORM
  RESELLER
  API_PARTNER
  MERCHANT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum MfaFactorType {
  TOTP
  /// WebAuthn passkey / security key (phishing-resistant).
  PASSKEY
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------------------------

/// Tenant root. Hierarchy PLATFORM -> RESELLER -> MERCHANT via parentId.
model Organization {
  id                  String             @id
  type                OrganizationType
  status              OrganizationStatus @default(ACTIVE)
  name                String             @db.VarChar(160)
  slug                String             @unique @db.VarChar(80)
  parentId            String?            @map("parent_id")
  /// Sales owner for resellers and merchants (CRM, Phase 2).
  assignedSalesUserId String?            @map("assigned_sales_user_id")
  /// Acquisition source (e.g. "referral", "website", lead id).
  source              String?            @db.VarChar(80)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant         Merchant?
  parent           Organization?     @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Organization[]    @relation("OrganizationHierarchy")
  members          UserRole[]
  roles            Role[]
  sessions         Session[]
  dashboardIpRules DashboardIpRule[]

  @@index([parentId])
  @@index([type, status, createdAt(sort: Desc)])
  @@index([assignedSalesUserId])
  @@map("organizations")
}

/// A person. Global identity; access to organizations is granted through UserRole memberships.
model User {
  id                String     @id
  name              String     @db.VarChar(120)
  email             String     @unique @db.VarChar(254)
  mobile            String?    @unique @db.VarChar(16)
  passwordHash      String     @map("password_hash")
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp       String?    @map("last_login_ip") @db.VarChar(45)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdById       String?    @map("created_by_id")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         UserRole[]           @relation("UserMemberships")
  grantedMemberships  UserRole[]           @relation("MembershipGrantedBy")
  sessions            Session[]
  mfaFactors          MfaFactor[]
  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]

  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

model Role {
  id             String           @id
  /// Stable key, e.g. SUPER_ADMIN / MERCHANT_OWNER. Unique among system roles (partial index in SQL).
  key            String           @db.VarChar(40)
  name           String           @db.VarChar(80)
  description    String           @default("") @db.VarChar(255)
  /// Organization type this role can be granted in.
  scope          OrganizationType
  /// null = system role available to every org of `scope`; set = custom role owned by that org.
  organizationId String?          @map("organization_id")
  isSystem       Boolean          @default(false) @map("is_system")
  requiresMfa    Boolean          @default(false) @map("requires_mfa")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  UserRole[]

  @@unique([organizationId, key])
  @@index([scope])
  @@map("roles")
}

/// Permission catalog mirror of packages/auth/src/permissions.ts (synced by seed/sync script).
model Permission {
  key         String             @id @db.VarChar(60)
  description String             @db.VarChar(255)
  scopes      OrganizationType[]
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String   @map("role_id")
  permissionKey String   @map("permission_key") @db.VarChar(60)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Membership: user x role x organization.
model UserRole {
  id             String   @id
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  organizationId String   @map("organization_id")
  grantedById    String?  @map("granted_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation("UserMemberships", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grantedBy    User?        @relation("MembershipGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, organizationId])
  @@index([organizationId, userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------------------------
// Sessions & credentials
// ---------------------------------------------------------------------------------------------

model Session {
  id                    String    @id
  userId                String    @map("user_id")
  /// Active organization for this session — the tenant context of every dashboard request.
  organizationId        String    @map("organization_id")
  ipAddress             String?   @map("ip_address") @db.VarChar(45)
  userAgent             String?   @map("user_agent") @db.VarChar(512)
  mfaVerifiedAt         DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  /// Restricted session: user must enroll TOTP before reaching protected routes.
  mfaEnrollmentRequired Boolean   @default(false) @map("mfa_enrollment_required")
  /// Last time the user proved who they are (sign-in or step-up). Sensitive actions need it recent.
  reauthenticatedAt     DateTime  @default(now()) @map("reauthenticated_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt            DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason         String?   @map("revoked_reason") @db.VarChar(40)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rotating refresh token. Only SHA-256(token) is stored. Reuse of a used token revokes the session.
model RefreshToken {
  id           String    @id
  sessionId    String    @map("session_id")
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model MfaFactor {
  id              String          @id
  userId          String          @map("user_id")
  type            MfaFactorType   @default(TOTP)
  status          MfaFactorStatus @default(PENDING)
  /// TOTP only: AES-256-GCM envelope (v1.<keyId>.<iv>.<tag>.<ct>), AAD = user id.
  secretEncrypted String?         @map("secret_encrypted")
  /// Last accepted TOTP time step — codes at or before it are rejected (replay protection).
  lastUsedStep    Int?            @map("last_used_step")
  /// PASSKEY only: user-given label ("MacBook Touch ID").
  name            String?         @db.VarChar(60)
  /// PASSKEY only: base64url credential id (globally unique).
  credentialId    String?         @unique @map("credential_id") @db.VarChar(1024)
  /// PASSKEY only: COSE public key. Public data, not a secret.
  publicKey       Bytes?          @map("public_key")
  /// PASSKEY only: authenticator signature counter (clone detection when non-zero).
  signCount       BigInt?         @map("sign_count")
  transports      String[]        @default([])
  lastUsedAt      DateTime?       @map("last_used_at") @db.Timestamptz(3)
  confirmedAt     DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  disabledAt      DateTime?       @map("disabled_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("mfa_factors")
}

model PasswordResetToken {
  id          String    @id
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------------------------
// Audit, outbox, notifications
// ---------------------------------------------------------------------------------------------

/// Append-only (UPDATE/DELETE blocked by trigger). No FKs so records outlive their subjects and the
/// table can be range-partitioned later.
model AuditLog {
  id             String    @id
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id")
  actorRole      String?   @map("actor_role") @db.VarChar(200)
  organizationId String?   @map("organization_id")
  action         String    @db.VarChar(100)
  resourceType   String    @map("resource_type") @db.VarChar(50)
  resourceId     String?   @map("resource_id") @db.VarChar(60)
  oldValue       Json?     @map("old_value")
  newValue       Json?     @map("new_value")
  metadata       Json?
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  requestId      String?   @map("request_id") @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}

/// Transactional outbox (docs/ARCHITECTURE.md §8). Written in the same transaction as the business
/// change; published to Kafka by the worker relay.
model OutboxEvent {
  id            String    @id
  eventType     String    @map("event_type") @db.VarChar(80)
  aggregateType String    @map("aggregate_type") @db.VarChar(40)
  aggregateId   String    @map("aggregate_id") @db.VarChar(60)
  version       Int       @default(1)
  payload       Json
  headers       Json      @default("{}")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(1000)

  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model Notification {
  id                 String              @id
  channel            NotificationChannel
  template           String              @db.VarChar(80)
  /// Masked recipient only (a***@example.com) — full address lives with the subject user.
  recipientMasked    String              @map("recipient_masked") @db.VarChar(254)
  userId             String?             @map("user_id")
  status             NotificationStatus  @default(QUEUED)
  /// Rendered message (to, subject, body) encrypted at rest; wiped once sent. May contain one-time links.
  contentEncrypted   String?             @map("content_encrypted")
  attempts           Int                 @default(0)
  nextAttemptAt      DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  providerMessageId  String?             @map("provider_message_id") @db.VarChar(200)
  /// Messaging service that accepted it (docs/VENDORS.md).
  messagingServiceId String?             @map("messaging_service_id")
  /// Send through this service only (test sends from the vendor screen); null = channel routing.
  targetServiceId    String?             @map("target_service_id")
  error              String?             @db.VarChar(1000)
  requestId          String?             @map("request_id") @db.VarChar(40)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt             DateTime?           @map("sent_at") @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("notifications")
}

/// Single-use MFA recovery codes. Stored as keyed HMAC (blind index) — useless without the server key.
model MfaRecoveryCode {
  id        String    @id
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

// ---------------------------------------------------------------------------------------------
// Phase 2 — Merchants & compliance
// ---------------------------------------------------------------------------------------------

enum MerchantStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum EntityType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  ONE_PERSON_COMPANY
  TRUST
  SOCIETY
  HUF
  GOVERNMENT
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
}

enum SettlementCycle {
  T0
  T1
  T2
  CUSTOM
}

enum ScreeningStatus {
  NOT_STARTED
  PENDING
  CLEAR
  MATCH_FOUND
  FALSE_POSITIVE
}

enum DocumentType {
  PAN
  GST_CERTIFICATE
  CIN_CERTIFICATE
  ADDRESS_PROOF
  BANK_PROOF
  CANCELLED_CHEQUE
  DIRECTOR_KYC
  AGREEMENT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

enum BankAccountType {
  CURRENT
  SAVINGS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ComplianceAction {
  CREATED
  SUBMITTED
  REVIEW_STARTED
  INFORMATION_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REACTIVATED
}

enum LimitLevel {
  SYSTEM
  RESELLER
  MERCHANT
}

enum ServiceType {
  PAYIN
  PAYOUT
  /// Manual ledger adjustments (maker-checker policy only).
  ADJUSTMENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/// Merchant aggregate. Shares its primary key with its Organization (merchantId == organizationId).
model Merchant {
  id                String            @id
  /// Denormalised parent reseller (null = direct Pay2All merchant) for single-index reseller scoping.
  resellerId        String?           @map("reseller_id")
  status            MerchantStatus    @default(DRAFT)
  payinEnabled      Boolean           @default(false) @map("payin_enabled")
  payoutEnabled     Boolean           @default(false) @map("payout_enabled")
  riskCategory      RiskCategory?     @map("risk_category")
  /// What to do when a provider reports success after we expired/failed a payment.
  lateSuccessPolicy LateSuccessPolicy @default(AUTO_ACCEPT) @map("late_success_policy")
  /// Pricing scheme assigned by the platform (null = the default scheme / rate cards; docs/PRICING_SCHEMES.md).
  schemeId          String?           @map("scheme_id")
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz(3)
  approvedAt        DateTime?         @map("approved_at") @db.Timestamptz(3)
  /// Optimistic concurrency for status transitions.
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [id], references: [id], onDelete: Restrict)
  scheme       Scheme?               @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  profile      MerchantProfile?
  kyc          MerchantKyc?
  persons      MerchantPerson[]
  documents    MerchantDocument[]
  bankAccounts MerchantBankAccount[]
  reviews      ComplianceReview[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([resellerId, createdAt(sort: Desc)])
  @@index([schemeId])
  @@map("merchants")
}

model MerchantProfile {
  merchantId                 String           @id @map("merchant_id")
  legalName                  String?          @map("legal_name") @db.VarChar(200)
  displayName                String?          @map("display_name") @db.VarChar(120)
  entityType                 EntityType?      @map("entity_type")
  /// Business PAN (public registry data for companies/firms; proprietors' PAN is personal but required).
  pan                        String?          @db.Char(10)
  gstin                      String?          @db.Char(15)
  cin                        String?          @db.Char(21)
  llpin                      String?          @db.VarChar(8)
  registeredAddress          Json?            @map("registered_address")
  operationalAddress         Json?            @map("operational_address")
  website                    String?          @db.VarChar(300)
  appUrl                     String?          @map("app_url") @db.VarChar(300)
  businessCategory           String?          @map("business_category") @db.VarChar(100)
  mcc                        String?          @db.Char(4)
  businessDescription        String?          @map("business_description") @db.VarChar(2000)
  expectedMonthlyVolumeMinor BigInt?          @map("expected_monthly_volume_minor")
  averageTicketMinor         BigInt?          @map("average_ticket_minor")
  maximumTicketMinor         BigInt?          @map("maximum_ticket_minor")
  payinRequired              Boolean          @default(false) @map("payin_required")
  payoutRequired             Boolean          @default(false) @map("payout_required")
  settlementPreference       SettlementCycle? @map("settlement_preference")
  contactName                String?          @map("contact_name") @db.VarChar(120)
  contactEmail               String?          @map("contact_email") @db.VarChar(254)
  contactMobile              String?          @map("contact_mobile") @db.VarChar(16)
  updatedById                String?          @map("updated_by_id")
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([pan])
  @@index([gstin])
  @@map("merchant_profiles")
}

/// Screening and risk assessment state (provider integrations later; statuses recorded now).
model MerchantKyc {
  merchantId         String          @id @map("merchant_id")
  sanctionsStatus    ScreeningStatus @default(NOT_STARTED) @map("sanctions_status")
  pepStatus          ScreeningStatus @default(NOT_STARTED) @map("pep_status")
  adverseMediaStatus ScreeningStatus @default(NOT_STARTED) @map("adverse_media_status")
  screenedAt         DateTime?       @map("screened_at") @db.Timestamptz(3)
  screenedById       String?         @map("screened_by_id")
  riskNotes          String?         @map("risk_notes") @db.VarChar(2000)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("merchant_kyc")
}

/// Directors, partners, proprietors, UBOs and signatories (one person may hold several roles).
model MerchantPerson {
  id                    String             @id
  merchantId            String             @map("merchant_id")
  fullName              String             @map("full_name") @db.VarChar(120)
  designation           String?            @db.VarChar(80)
  panEncrypted          String             @map("pan_encrypted")
  panMasked             String             @map("pan_masked") @db.VarChar(10)
  panHash               String             @map("pan_hash") @db.Char(64)
  din                   String?            @db.Char(8)
  email                 String?            @db.VarChar(254)
  mobile                String?            @db.VarChar(16)
  isDirector            Boolean            @default(false) @map("is_director")
  isUbo                 Boolean            @default(false) @map("is_ubo")
  isAuthorizedSignatory Boolean            @default(false) @map("is_authorized_signatory")
  ownershipPercent      Decimal?           @map("ownership_percent") @db.Decimal(5, 2)
  kycStatus             VerificationStatus @default(PENDING) @map("kyc_status")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant  Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  documents MerchantDocument[]

  @@index([merchantId])
  @@index([panHash])
  @@map("merchant_persons")
}

/// Document metadata only; the file lives in S3-compatible storage under `storageKey`.
model MerchantDocument {
  id              String         @id
  merchantId      String         @map("merchant_id")
  personId        String?        @map("person_id")
  type            DocumentType
  status          DocumentStatus @default(UPLOADED)
  fileName        String         @map("file_name") @db.VarChar(200)
  mimeType        String         @map("mime_type") @db.VarChar(100)
  sizeBytes       Int            @map("size_bytes")
  sha256          String         @db.Char(64)
  storageKey      String         @unique @map("storage_key") @db.VarChar(300)
  description     String?        @db.VarChar(200)
  expiresAt       DateTime?      @map("expires_at") @db.Date
  uploadedById    String?        @map("uploaded_by_id")
  reviewedById    String?        @map("reviewed_by_id")
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  person   MerchantPerson? @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([merchantId, type, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("merchant_documents")
}

/// Settlement bank account. Full number encrypted; masked copy for display; HMAC for duplicate detection.
model MerchantBankAccount {
  id                     String             @id
  merchantId             String             @map("merchant_id")
  accountHolderName      String             @map("account_holder_name") @db.VarChar(120)
  accountNumberEncrypted String             @map("account_number_encrypted")
  accountNumberMasked    String             @map("account_number_masked") @db.VarChar(18)
  accountNumberHash      String             @map("account_number_hash") @db.Char(64)
  ifsc                   String             @db.Char(11)
  bankName               String?            @map("bank_name") @db.VarChar(120)
  accountType            BankAccountType    @default(CURRENT) @map("account_type")
  verificationStatus     VerificationStatus @default(PENDING) @map("verification_status")
  verificationReference  String?            @map("verification_reference") @db.VarChar(100)
  verifiedById           String?            @map("verified_by_id")
  verifiedAt             DateTime?          @map("verified_at") @db.Timestamptz(3)
  isPrimary              Boolean            @default(false) @map("is_primary")
  isActive               Boolean            @default(true) @map("is_active")
  createdById            String?            @map("created_by_id")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, isActive])
  @@index([accountNumberHash])
  @@map("merchant_bank_accounts")
}

/// Append-only compliance history (UPDATE/DELETE blocked by trigger). Never deleted.
model ComplianceReview {
  id           String           @id
  merchantId   String           @map("merchant_id")
  action       ComplianceAction
  fromStatus   MerchantStatus?  @map("from_status")
  toStatus     MerchantStatus   @map("to_status")
  reviewedById String?          @map("reviewed_by_id")
  reviewedAt   DateTime         @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  reason       String?          @db.VarChar(500)
  notes        String?          @db.VarChar(4000)
  /// Snapshot of what the reviewer saw/decided (risk category, enabled services, checklist).
  details      Json?
  requestId    String?          @map("request_id") @db.VarChar(40)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, reviewedAt(sort: Desc)])
  @@map("compliance_reviews")
}

/// Transaction limits. A null field inherits from the broader level (MERCHANT → RESELLER → SYSTEM).
model LimitConfig {
  id                 String      @id
  level              LimitLevel
  /// Organization id for RESELLER/MERCHANT; null for SYSTEM.
  subjectId          String?     @map("subject_id")
  service            ServiceType
  perTxnMinMinor     BigInt?     @map("per_txn_min_minor")
  perTxnMaxMinor     BigInt?     @map("per_txn_max_minor")
  dailyAmountMinor   BigInt?     @map("daily_amount_minor")
  dailyCount         Int?        @map("daily_count")
  monthlyAmountMinor BigInt?     @map("monthly_amount_minor")
  monthlyCount       Int?        @map("monthly_count")
  updatedById        String?     @map("updated_by_id")
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([level, subjectId, service])
  @@map("limit_configs")
}

/// Maker-checker tiers for payouts: [{ up_to_minor: "1000000" | null, approvals_required: 0..3 }].
model ApprovalPolicy {
  id                  String      @id
  level               LimitLevel
  subjectId           String?     @map("subject_id")
  service             ServiceType @default(PAYOUT)
  makerCheckerEnabled Boolean     @default(true) @map("maker_checker_enabled")
  tiers               Json
  updatedById         String?     @map("updated_by_id")
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([level, subjectId, service])
  @@map("approval_policies")
}

/// Basic onboarding CRM.
model SalesLead {
  id                    String     @id
  companyName           String     @map("company_name") @db.VarChar(160)
  contactName           String     @map("contact_name") @db.VarChar(120)
  contactEmail          String?    @map("contact_email") @db.VarChar(254)
  contactMobile         String?    @map("contact_mobile") @db.VarChar(16)
  source                String     @db.VarChar(80)
  expectedMonthlyVolume String?    @map("expected_monthly_volume") @db.VarChar(40)
  status                LeadStatus @default(NEW)
  assignedSalesUserId   String?    @map("assigned_sales_user_id")
  followUpDate          DateTime?  @map("follow_up_date") @db.Date
  /// Append-only notes log: [{ at, by, text }].
  notes                 Json       @default("[]")
  convertedMerchantId   String?    @unique @map("converted_merchant_id")
  convertedAt           DateTime?  @map("converted_at") @db.Timestamptz(3)
  createdById           String?    @map("created_by_id")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, followUpDate])
  @@index([assignedSalesUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("sales_leads")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 — Double-entry ledger (docs/LEDGER.md)
// ---------------------------------------------------------------------------------------------

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
  CLEARING
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum LedgerOwnerType {
  PLATFORM
  MERCHANT
  RESELLER
}

enum LedgerBucket {
  AVAILABLE
  PENDING
  UNSETTLED
  SETTLED
  RESERVED
  LIEN
  RECEIVABLE
  COMMISSION_PAYABLE
}

enum JournalType {
  PAYIN_CAPTURE
  PROVIDER_SETTLEMENT
  SETTLEMENT
  SETTLEMENT_TRANSFER
  SETTLEMENT_PAID
  SETTLEMENT_RETURN
  COMMISSION_PAYOUT
  HOLD_RELEASE
  REFUND
  REFUND_REVERSAL
  CHARGEBACK_LIEN
  CHARGEBACK_DEBIT
  CHARGEBACK_RELEASE
  PAYOUT_RESERVE
  PAYOUT_SETTLE
  PAYOUT_RELEASE
  PAYOUT_REVERSAL
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  LIEN_PLACE
  LIEN_RELEASE
  COMMISSION_ACCRUAL
  PROVIDER_CHARGE
  REVERSAL
  /// Merchant wallet top-up approved from a fund request.
  FUND_LOAD
}

enum JournalSourceType {
  PAYMENT
  PAYOUT
  REFUND
  SETTLEMENT
  CHARGEBACK
  ADJUSTMENT
  PROVIDER
  RISK
  JOURNAL
  SYSTEM
  FUND_REQUEST
}

enum AdjustmentDirection {
  CREDIT
  DEBIT
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED
  CANCELLED
}

/// Ledger account. `balanceMinor` is maintained (and row-locked) only for merchant/reseller accounts;
/// hot platform accounts keep NULL and are aggregated from entries (docs/LEDGER.md §6).
model LedgerAccount {
  id            String            @id
  code          String            @unique @db.VarChar(120)
  name          String            @db.VarChar(160)
  type          LedgerAccountType
  normalBalance EntryDirection    @map("normal_balance")
  ownerType     LedgerOwnerType   @map("owner_type")
  ownerId       String?           @map("owner_id")
  bucket        LedgerBucket?
  currency      String            @db.Char(3)
  allowNegative Boolean           @default(false) @map("allow_negative")
  balanceMinor  BigInt?           @map("balance_minor")
  version       Int               @default(0)
  metadata      Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries   LedgerEntry[]
  snapshots BalanceSnapshot[]

  @@index([ownerType, ownerId])
  @@index([type, createdAt])
  @@map("ledger_accounts")
}

/// Immutable journal header. `idempotencyKey` makes every posting exactly-once.
model LedgerJournal {
  id                String            @id
  type              JournalType
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(160)
  /// sha256 of the canonical (type, source, lines) — a replay with different lines is a bug.
  linesHash         String            @map("lines_hash") @db.Char(64)
  sourceType        JournalSourceType @map("source_type")
  sourceId          String            @map("source_id") @db.VarChar(60)
  reversesJournalId String?           @unique @map("reverses_journal_id")
  description       String?           @db.VarChar(300)
  metadata          Json              @default("{}")
  effectiveAt       DateTime          @map("effective_at") @db.Timestamptz(3)
  postedAt          DateTime          @default(now()) @map("posted_at") @db.Timestamptz(3)
  createdById       String?           @map("created_by_id")
  requestId         String?           @map("request_id") @db.VarChar(40)

  entries LedgerEntry[]

  @@index([sourceType, sourceId])
  @@index([type, postedAt(sort: Desc)])
  @@index([postedAt(sort: Desc), id(sort: Desc)])
  @@map("ledger_journals")
}

/// Immutable journal line. amount > 0; sign comes from direction.
model LedgerEntry {
  id                String         @id
  journalId         String         @map("journal_id")
  accountId         String         @map("account_id")
  direction         EntryDirection
  amountMinor       BigInt         @map("amount_minor")
  currency          String         @db.Char(3)
  /// Running balance of the account after this line (maintained accounts only).
  balanceAfterMinor BigInt?        @map("balance_after_minor")
  memo              String?        @db.VarChar(200)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([journalId])
  @@map("ledger_entries")
}

/// Daily closing balance per account (00:00 IST cut-off) for statements and fast history.
model BalanceSnapshot {
  id           String   @id
  accountId    String   @map("account_id")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  balanceMinor BigInt   @map("balance_minor")
  debitsMinor  BigInt   @map("debits_minor")
  creditsMinor BigInt   @map("credits_minor")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
  @@map("balance_snapshots")
}

/// Manual balance adjustment with maker-checker. Admins never edit balances directly.
model LedgerAdjustment {
  id                String              @id
  merchantId        String              @map("merchant_id")
  direction         AdjustmentDirection
  amountMinor       BigInt              @map("amount_minor")
  currency          String              @default("INR") @db.Char(3)
  reason            String              @db.VarChar(500)
  reference         String              @db.VarChar(120)
  supportingNote    String?             @map("supporting_note") @db.VarChar(2000)
  status            AdjustmentStatus    @default(PENDING_APPROVAL)
  approvalsRequired Int                 @map("approvals_required")
  makerId           String              @map("maker_id")
  journalId         String?             @unique @map("journal_id")
  rejectedById      String?             @map("rejected_by_id")
  rejectionReason   String?             @map("rejection_reason") @db.VarChar(500)
  postedAt          DateTime?           @map("posted_at") @db.Timestamptz(3)
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvals LedgerAdjustmentApproval[]

  @@index([status, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("ledger_adjustments")
}

model LedgerAdjustmentApproval {
  id           String   @id
  adjustmentId String   @map("adjustment_id")
  approverId   String   @map("approver_id")
  comment      String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  adjustment LedgerAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, approverId])
  @@map("ledger_adjustment_approvals")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 — Providers, routing and health (docs/ARCHITECTURE.md §9)
// ---------------------------------------------------------------------------------------------

enum ProviderKind {
  PAYIN
  PAYOUT
  BOTH
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  DOWN
  MAINTENANCE
  DISABLED
}

/// AUTO = set by the circuit breaker; MANUAL = set by an operator (never auto-overridden).
enum StatusSource {
  AUTO
  MANUAL
}

enum ProviderEnvironment {
  TEST
  LIVE
}

enum RouteTier {
  PRIMARY
  SECONDARY
  FALLBACK
}

enum InboundWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// A bank / PSP / PA integration. Business logic never references a provider directly — it goes
/// through the routing engine and the adapter interface.
model Provider {
  id              String              @id
  code            String              @unique @db.VarChar(40)
  name            String              @db.VarChar(120)
  kind            ProviderKind
  /// The API vendor (company) this payment service belongs to (docs/VENDORS.md).
  vendorId        String?             @map("vendor_id")
  /// Adapter implementation key in @pay2all/providers (mock, provider-a, provider-b, …).
  adapter         String              @db.VarChar(40)
  environment     ProviderEnvironment @default(TEST)
  status          ProviderStatus      @default(ACTIVE)
  statusSource    StatusSource        @default(MANUAL) @map("status_source")
  statusReason    String?             @map("status_reason") @db.VarChar(300)
  statusChangedAt DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  /// { payin_methods: [...], payout_modes: [...], min_amount_minor, max_amount_minor }
  capabilities    Json                @default("{}")
  /// Non-secret configuration: { base_url, timeout_ms, ... }
  config          Json                @default("{}")
  /// Indicative costs for routing: { payin_rate_micros, payout_flat_minor }
  costs           Json                @default("{}")
  version         Int                 @default(1)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor      ApiVendor?               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  credentials ProviderCredential[]
  routes      ProviderRoute[]
  snapshots   ProviderHealthSnapshot[]
  webhooks    ProviderWebhookEvent[]
  staticQrs   StaticQr[]

  @@index([kind, status])
  @@index([vendorId])
  @@map("providers")
}

/// Encrypted credential bundle per provider and environment. Values are write-only via the API.
model ProviderCredential {
  id              String              @id
  providerId      String              @map("provider_id")
  environment     ProviderEnvironment
  /// AES-256-GCM envelope of a JSON object { key: value }, AAD = providerId:environment.
  secretEncrypted String              @map("secret_encrypted")
  /// Key names and last-4 fingerprints for display: { api_key: "…9f3a" }.
  fingerprints    Json                @default("{}")
  rotatedAt       DateTime            @default(now()) @map("rotated_at") @db.Timestamptz(3)
  rotatedById     String?             @map("rotated_by_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, environment])
  @@map("provider_credentials")
}

/// Routing rule: when the match criteria apply, `provider` is a candidate at `tier`/`priority`.
model ProviderRoute {
  id             String         @id
  name           String         @db.VarChar(120)
  service        ServiceType
  tier           RouteTier      @default(PRIMARY)
  /// Lower runs first within a tier.
  priority       Int            @default(100)
  isActive       Boolean        @default(true) @map("is_active")
  providerId     String         @map("provider_id")
  merchantId     String?        @map("merchant_id")
  resellerId     String?        @map("reseller_id")
  /// Payin method (UPI_QR, …) or payout mode (IMPS, …); null = any.
  method         String?        @db.VarChar(30)
  minAmountMinor BigInt?        @map("min_amount_minor")
  maxAmountMinor BigInt?        @map("max_amount_minor")
  riskCategories RiskCategory[] @map("risk_categories")
  /// Optional IST window { start: "HH:MM", end: "HH:MM", days: [1..7] }.
  timeWindow     Json?          @map("time_window")
  createdById    String?        @map("created_by_id")
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([service, isActive, tier, priority])
  @@index([merchantId])
  @@index([resellerId])
  @@map("provider_routes")
}

/// Periodic health snapshot (the live window lives in Redis).
model ProviderHealthSnapshot {
  id            String         @id
  providerId    String         @map("provider_id")
  service       ServiceType
  windowStart   DateTime       @map("window_start") @db.Timestamptz(3)
  windowEnd     DateTime       @map("window_end") @db.Timestamptz(3)
  requests      Int
  successes     Int
  failures      Int
  timeouts      Int
  avgLatencyMs  Int?           @map("avg_latency_ms")
  p95LatencyMs  Int?           @map("p95_latency_ms")
  p99LatencyMs  Int?           @map("p99_latency_ms")
  status        ProviderStatus
  lastSuccessAt DateTime?      @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt DateTime?      @map("last_failure_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt(sort: Desc)])
  @@map("provider_health_snapshots")
}

/// Inbound provider callbacks: verified, de-duplicated by the provider's event id, stored redacted.
model ProviderWebhookEvent {
  id              String               @id
  providerId      String               @map("provider_id")
  externalEventId String               @map("external_event_id") @db.VarChar(120)
  eventType       String               @map("event_type") @db.VarChar(60)
  signatureValid  Boolean              @map("signature_valid")
  payload         Json
  status          InboundWebhookStatus @default(RECEIVED)
  error           String?              @db.VarChar(500)
  requestId       String?              @map("request_id") @db.VarChar(40)
  receivedAt      DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?            @map("processed_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalEventId])
  @@index([status, receivedAt])
  @@map("provider_webhook_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 5 — Payin, refunds, pricing, idempotency (docs/PAYIN_FLOW.md)
// ---------------------------------------------------------------------------------------------

enum LateSuccessPolicy {
  AUTO_ACCEPT
  MANUAL_REVIEW
}

enum PayinMethod {
  UPI_QR
  UPI_INTENT
  /// Credit to a merchant's static (printed) UPI QR — any amount, recorded when the provider reports it.
  UPI_STATIC_QR
  PAYMENT_LINK
  VIRTUAL_ACCOUNT
  IMPS
  NEFT
  RTGS
  CARD
  NETBANKING
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  SETTLEMENT_PENDING
  SETTLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CHARGEBACK
}

enum AttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum RefundStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  MANUAL_REVIEW
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum PricingPlanKind {
  /// What a provider charges Pay2All.
  PROVIDER_COST
  /// What Pay2All charges a reseller (wholesale).
  WHOLESALE
  /// What the merchant is charged.
  MERCHANT
}

enum PricingPlanStatus {
  ACTIVE
  ARCHIVED
}

enum ChargeType {
  FLAT
  PERCENTAGE
  PERCENTAGE_WITH_MIN_MAX
}

enum PricingSubjectType {
  MERCHANT
  RESELLER
  PROVIDER
}

/// A collection. `id` (pay_…) is Pay2All's external id; provider ids are separate columns.
model Payment {
  id                    String        @id
  merchantId            String        @map("merchant_id")
  resellerId            String?       @map("reseller_id")
  merchantOrderId       String        @map("merchant_order_id") @db.VarChar(64)
  /// Hosted checkout this payment is an attempt of (merchant_order_id is then "<order>#<n>").
  checkoutSessionId     String?       @map("checkout_session_id")
  /// UPI_STATIC_QR payments: the merchant QR that was credited.
  staticQrId            String?       @map("static_qr_id")
  /// How to send the customer to a hosted gateway (redirect / form post / Atom script).
  checkoutAction        Json?         @map("checkout_action")
  method                PayinMethod
  status                PaymentStatus @default(CREATED)
  amountMinor           BigInt        @map("amount_minor")
  currency              String        @default("INR") @db.Char(3)
  feeMinor              BigInt        @default(0) @map("fee_minor")
  taxMinor              BigInt        @default(0) @map("tax_minor")
  /// Scheme commission credited to the merchant (instead of a fee).
  commissionMinor       BigInt        @default(0) @map("commission_minor")
  netAmountMinor        BigInt        @map("net_amount_minor")
  refundedAmountMinor   BigInt        @default(0) @map("refunded_amount_minor")
  providerId            String?       @map("provider_id")
  routeId               String?       @map("route_id")
  providerOrderId       String?       @map("provider_order_id") @db.VarChar(120)
  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(120)
  utr                   String?       @db.VarChar(40)
  rrn                   String?       @db.VarChar(40)
  payerVpa              String?       @map("payer_vpa") @db.VarChar(120)
  customerName          String?       @map("customer_name") @db.VarChar(120)
  customerMobile        String?       @map("customer_mobile") @db.VarChar(16)
  customerEmail         String?       @map("customer_email") @db.VarChar(254)
  description           String?       @db.VarChar(200)
  metadata              Json          @default("{}")
  qrPayload             String?       @map("qr_payload") @db.VarChar(1000)
  upiIntent             String?       @map("upi_intent") @db.VarChar(1000)
  paymentLink           String?       @map("payment_link") @db.VarChar(500)
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(3)
  successAt             DateTime?     @map("success_at") @db.Timestamptz(3)
  failedAt              DateTime?     @map("failed_at") @db.Timestamptz(3)
  failureCode           String?       @map("failure_code") @db.VarChar(60)
  failureReason         String?       @map("failure_reason") @db.VarChar(300)
  settledAt             DateTime?     @map("settled_at") @db.Timestamptz(3)
  settlementId          String?       @map("settlement_id")
  lateSuccess           Boolean       @default(false) @map("late_success")
  requiresReview        Boolean       @default(false) @map("requires_review")
  reviewReason          String?       @map("review_reason") @db.VarChar(300)
  /// Set once the reseller commission for this payin has been accrued (or found to be zero).
  commissionAccruedAt   DateTime?     @map("commission_accrued_at") @db.Timestamptz(3)
  captureJournalId      String?       @map("capture_journal_id")
  nextPollAt            DateTime?     @map("next_poll_at") @db.Timestamptz(3)
  pollCount             Int           @default(0) @map("poll_count")
  createdById           String?       @map("created_by_id")
  requestId             String?       @map("request_id") @db.VarChar(40)
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts PaymentAttempt[]
  refunds  Refund[]
  staticQr StaticQr?        @relation(fields: [staticQrId], references: [id], onDelete: Restrict)

  @@unique([merchantId, merchantOrderId])
  @@index([checkoutSessionId])
  @@index([staticQrId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([resellerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([providerId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("payments")
}

/// One provider call for a payment (failover creates more than one).
model PaymentAttempt {
  id              String        @id
  paymentId       String        @map("payment_id")
  attemptNo       Int           @map("attempt_no")
  providerId      String        @map("provider_id")
  status          AttemptStatus @default(INITIATED)
  providerOrderId String?       @map("provider_order_id") @db.VarChar(120)
  errorKind       String?       @map("error_kind") @db.VarChar(20)
  errorCode       String?       @map("error_code") @db.VarChar(60)
  errorMessage    String?       @map("error_message") @db.VarChar(300)
  latencyMs       Int?          @map("latency_ms")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNo])
  @@map("payment_attempts")
}

model Refund {
  id                      String       @id
  paymentId               String       @map("payment_id")
  merchantId              String       @map("merchant_id")
  merchantRefundId        String?      @map("merchant_refund_id") @db.VarChar(64)
  amountMinor             BigInt       @map("amount_minor")
  /// Share of the payment's scheme commission taken back with this refund.
  commissionClawbackMinor BigInt       @default(0) @map("commission_clawback_minor")
  currency                String       @default("INR") @db.Char(3)
  reason                  String?      @db.VarChar(300)
  status                  RefundStatus @default(CREATED)
  providerId              String       @map("provider_id")
  providerRefundId        String?      @map("provider_refund_id") @db.VarChar(120)
  failureReason           String?      @map("failure_reason") @db.VarChar(300)
  attempts                Int          @default(0)
  nextAttemptAt           DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  journalId               String?      @map("journal_id")
  reversalJournalId       String?      @map("reversal_journal_id")
  createdById             String?      @map("created_by_id")
  completedAt             DateTime?    @map("completed_at") @db.Timestamptz(3)
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("refunds")
}

/// Request-level idempotency (docs/PAYIN_FLOW.md §4).
model IdempotencyRecord {
  id                 String            @id
  merchantId         String            @map("merchant_id")
  idempotencyKey     String            @map("idempotency_key") @db.VarChar(64)
  requestMethod      String            @map("request_method") @db.VarChar(8)
  requestPath        String            @map("request_path") @db.VarChar(200)
  requestHash        String            @map("request_hash") @db.Char(64)
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatusCode Int?              @map("response_status_code")
  responseBody       Json?             @map("response_body")
  resourceId         String?           @map("resource_id") @db.VarChar(60)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([merchantId, idempotencyKey])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model PricingPlan {
  id            String            @id
  name          String            @db.VarChar(120)
  kind          PricingPlanKind
  status        PricingPlanStatus @default(ACTIVE)
  /// Organization that owns/edits the plan (platform, or a reseller for its merchants).
  ownerOrgId    String            @map("owner_org_id")
  /// Default plan of its kind for the owner when no assignment exists.
  isDefault     Boolean           @default(false) @map("is_default")
  /// GST on the fee, as rate micros (18% = 18000000).
  taxRateMicros BigInt            @default(18000000) @map("tax_rate_micros")
  /// Return the merchant fee on refund (default: no).
  refundFee     Boolean           @default(false) @map("refund_fee")
  effectiveFrom DateTime          @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime?         @map("effective_to") @db.Timestamptz(3)
  createdById   String?           @map("created_by_id")
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  rules       PricingRule[]
  assignments PricingAssignment[]

  @@index([kind, status, isDefault])
  @@map("pricing_plans")
}

model PricingRule {
  id             String      @id
  planId         String      @map("plan_id")
  service        ServiceType
  /// Payin method / payout mode; null = any.
  method         String?     @db.VarChar(30)
  providerId     String?     @map("provider_id")
  minAmountMinor BigInt?     @map("min_amount_minor")
  maxAmountMinor BigInt?     @map("max_amount_minor")
  chargeType     ChargeType  @map("charge_type")
  rateMicros     BigInt?     @map("rate_micros")
  flatMinor      BigInt?     @map("flat_minor")
  minFeeMinor    BigInt?     @map("min_fee_minor")
  maxFeeMinor    BigInt?     @map("max_fee_minor")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, service])
  @@map("pricing_rules")
}

model PricingAssignment {
  id            String             @id
  planId        String             @map("plan_id")
  subjectType   PricingSubjectType @map("subject_type")
  subjectId     String             @map("subject_id")
  effectiveFrom DateTime           @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime?          @map("effective_to") @db.Timestamptz(3)
  createdById   String?            @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, effectiveFrom(sort: Desc)])
  @@map("pricing_assignments")
}

enum SchemeStatus {
  ACTIVE
  ARCHIVED
}

enum SchemeValueType {
  FLAT
  PERCENT
}

/// A numbered pricing line (1 = Payout, 2 = Dynamic QR, 3 = Static QR, …) covering one service and
/// its payin methods / payout modes. Schemes price by these numbers. Not a bank/PSP (`Provider`).
model PricingProvider {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(80)
  service     ServiceType
  /// Payin methods or payout modes this line covers. A method belongs to at most one active line.
  methods     String[]
  description String?     @db.VarChar(300)
  isActive    Boolean     @default(true) @map("is_active")
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates SchemeRate[]

  @@map("pricing_providers")
}

/// Merchant pricing scheme: per provider, amount slabs with a signed value
/// (negative = charge to the merchant, positive = commission to the merchant), % or flat.
model Scheme {
  id            String       @id
  name          String       @db.VarChar(80)
  description   String?      @db.VarChar(300)
  status        SchemeStatus @default(ACTIVE)
  /// Merchants without an assigned scheme join this one (at most one, enforced by a partial index).
  isDefault     Boolean      @default(false) @map("is_default")
  /// GST on charges, as rate micros (18% = 18000000). Commissions carry no GST.
  taxRateMicros BigInt       @default(18000000) @map("tax_rate_micros")
  createdById   String?      @map("created_by_id")
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates     SchemeRate[]
  merchants Merchant[]

  @@index([status])
  @@map("schemes")
}

model SchemeRate {
  id             String          @id
  schemeId       String          @map("scheme_id")
  providerId     Int             @map("provider_id")
  /// Slab, inclusive. Null max = no upper limit.
  minAmountMinor BigInt          @map("min_amount_minor")
  maxAmountMinor BigInt?         @map("max_amount_minor")
  valueType      SchemeValueType @map("value_type")
  /// Signed. FLAT: paise. PERCENT: rate micros (1% = 1000000). Negative = charge, positive = commission.
  value          BigInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  scheme   Scheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  provider PricingProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([schemeId, providerId])
  @@index([providerId])
  @@map("scheme_rates")
}

/// Immutable record of exactly how a transaction was priced. Fees are never recomputed.
model TransactionPricingSnapshot {
  id                      String   @id
  transactionType         String   @map("transaction_type") @db.VarChar(20)
  transactionId           String   @unique @map("transaction_id")
  merchantId              String   @map("merchant_id")
  /// Plans and the exact rules applied (JSON copies — later plan edits can't change this).
  pricing                 Json
  merchantFeeMinor        BigInt   @map("merchant_fee_minor")
  merchantCommissionMinor BigInt   @default(0) @map("merchant_commission_minor")
  taxMinor                BigInt   @map("tax_minor")
  taxRateMicros           BigInt   @map("tax_rate_micros")
  wholesaleFeeMinor       BigInt?  @map("wholesale_fee_minor")
  providerCostMinor       BigInt   @map("provider_cost_minor")
  resellerMarginMinor     BigInt   @map("reseller_margin_minor")
  platformMarginMinor     BigInt   @map("platform_margin_minor")
  refundFee               Boolean  @default(false) @map("refund_fee")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([merchantId, createdAt])
  @@map("transaction_pricing_snapshots")
}

/// Merchant-facing event (payment.success, refund.failed …). Delivered by the webhook worker (Phase 7).
model WebhookEvent {
  id         String   @id
  merchantId String   @map("merchant_id")
  type       String   @db.VarChar(60)
  apiVersion String   @default("2026-10-01") @map("api_version") @db.VarChar(20)
  payload    Json
  resourceId String   @map("resource_id") @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([resourceId])
  @@map("webhook_events")
}

// ------------------------------------------------------------------------------------------------
// Payouts (Phase 6) — docs/PAYOUT_FLOW.md
// ------------------------------------------------------------------------------------------------

enum BeneficiaryType {
  INDIVIDUAL
  BUSINESS
}

enum BeneficiaryVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  BLOCKED
}

/// A payout destination owned by one merchant. The account number is stored encrypted, masked and
/// as a keyed blind index (duplicate / risk lookups without decrypting). Never returned in full.
model Beneficiary {
  id                     String                        @id
  merchantId             String                        @map("merchant_id")
  name                   String                        @db.VarChar(120)
  type                   BeneficiaryType               @default(INDIVIDUAL)
  accountNumberEncrypted String?                       @map("account_number_encrypted")
  accountNumberMasked    String?                       @map("account_number_masked") @db.VarChar(40)
  accountNumberHash      String?                       @map("account_number_hash") @db.VarChar(64)
  ifsc                   String?                       @db.VarChar(11)
  bankName               String?                       @map("bank_name") @db.VarChar(120)
  upiId                  String?                       @map("upi_id") @db.VarChar(255)
  mobile                 String?                       @db.VarChar(20)
  email                  String?                       @db.VarChar(254)
  verificationStatus     BeneficiaryVerificationStatus @default(PENDING) @map("verification_status")
  verificationReference  String?                       @map("verification_reference") @db.VarChar(120)
  verifiedName           String?                       @map("verified_name") @db.VarChar(160)
  nameMatchScore         Int?                          @map("name_match_score")
  verifiedAt             DateTime?                     @map("verified_at") @db.Timestamptz(3)
  verificationFailure    String?                       @map("verification_failure") @db.VarChar(300)
  blockedReason          String?                       @map("blocked_reason") @db.VarChar(300)
  createdById            String?                       @map("created_by_id")
  version                Int                           @default(1)
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  payouts Payout[]

  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([accountNumberHash])
  @@map("beneficiaries")
}

enum PayoutStatus {
  CREATED
  VALIDATING
  APPROVAL_PENDING
  MANUAL_REVIEW
  QUEUED
  PROCESSING
  PENDING
  SUCCESS
  FAILED
  REJECTED
  REVERSED
}

enum PayoutReviewKind {
  /// Held by a risk rule before anything was sent; funds reserved.
  RISK
  /// Sent, but the outcome could not be established; needs bank/provider evidence.
  UNKNOWN_OUTCOME
}

enum PayoutSource {
  DASHBOARD
  API
  BULK
}

model Payout {
  id                  String            @id
  merchantId          String            @map("merchant_id")
  resellerId          String?           @map("reseller_id")
  merchantOrderId     String            @map("merchant_order_id") @db.VarChar(64)
  mode                String            @db.VarChar(10)
  purpose             String            @db.VarChar(30)
  status              PayoutStatus      @default(CREATED)
  source              PayoutSource      @default(DASHBOARD)
  amountMinor         BigInt            @map("amount_minor")
  feeMinor            BigInt            @default(0) @map("fee_minor")
  taxMinor            BigInt            @default(0) @map("tax_minor")
  /// Scheme commission: reduces what the merchant is debited.
  commissionMinor     BigInt            @default(0) @map("commission_minor")
  /// amount + fee + tax: what is reserved from AVAILABLE.
  totalDebitMinor     BigInt            @map("total_debit_minor")
  currency            String            @default("INR") @db.Char(3)
  beneficiaryId       String            @map("beneficiary_id")
  /// Masked copy at creation time (name, masked account, IFSC / VPA) — never the full number.
  beneficiarySnapshot Json              @map("beneficiary_snapshot")
  narration           String?           @db.VarChar(100)
  metadata            Json?
  approvalsRequired   Int               @default(0) @map("approvals_required")
  approvalsReceived   Int               @default(0) @map("approvals_received")
  approvalExpiresAt   DateTime?         @map("approval_expires_at") @db.Timestamptz(3)
  providerId          String?           @map("provider_id")
  routeId             String?           @map("route_id")
  providerReference   String?           @map("provider_reference") @db.VarChar(120)
  utr                 String?           @db.VarChar(40)
  failureCode         String?           @map("failure_code") @db.VarChar(60)
  failureReason       String?           @map("failure_reason") @db.VarChar(300)
  reviewReason        String?           @map("review_reason") @db.VarChar(300)
  /// Why the payout is in MANUAL_REVIEW: held by risk before sending, or outcome unknown after.
  reviewKind          PayoutReviewKind? @map("review_kind")
  reserveJournalId    String?           @map("reserve_journal_id")
  /// Set once the reseller commission for this payout has been accrued (or found to be zero).
  commissionAccruedAt DateTime?         @map("commission_accrued_at") @db.Timestamptz(3)
  settleJournalId     String?           @map("settle_journal_id")
  releaseJournalId    String?           @map("release_journal_id")
  reversalJournalId   String?           @map("reversal_journal_id")
  queuedAt            DateTime?         @map("queued_at") @db.Timestamptz(3)
  processedAt         DateTime?         @map("processed_at") @db.Timestamptz(3)
  reversedAt          DateTime?         @map("reversed_at") @db.Timestamptz(3)
  nextAttemptAt       DateTime?         @map("next_attempt_at") @db.Timestamptz(3)
  pollCount           Int               @default(0) @map("poll_count")
  requeueCount        Int               @default(0) @map("requeue_count")
  bulkBatchId         String?           @map("bulk_batch_id")
  bulkRowNo           Int?              @map("bulk_row_no")
  createdById         String?           @map("created_by_id")
  requestId           String?           @map("request_id") @db.VarChar(64)
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  beneficiary Beneficiary      @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  attempts    PayoutAttempt[]
  approvals   PayoutApproval[]

  @@unique([merchantId, merchantOrderId])
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@index([beneficiaryId, createdAt])
  @@index([bulkBatchId])
  @@index([resellerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("payouts")
}

enum PayoutAttemptStatus {
  /// Committed before the provider call — an INITIATED attempt with no result means "outcome unknown".
  INITIATED
  ACCEPTED
  FAILED
  UNKNOWN
}

model PayoutAttempt {
  id                String              @id
  payoutId          String              @map("payout_id")
  attemptNo         Int                 @map("attempt_no")
  providerId        String              @map("provider_id")
  /// Our idempotency reference sent to the provider (`pout_X-1`); a new one only after a definitive failure.
  reference         String              @unique @db.VarChar(60)
  providerReference String?             @map("provider_reference") @db.VarChar(120)
  status            PayoutAttemptStatus @default(INITIATED)
  errorKind         String?             @map("error_kind") @db.VarChar(20)
  errorCode         String?             @map("error_code") @db.VarChar(60)
  errorMessage      String?             @map("error_message") @db.VarChar(300)
  latencyMs         Int?                @map("latency_ms")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(3)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, attemptNo])
  @@map("payout_attempts")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

/// Maker-checker votes. Append-only; one vote per approver per payout.
model PayoutApproval {
  id         String           @id
  payoutId   String           @map("payout_id")
  approverId String           @map("approver_id")
  decision   ApprovalDecision
  reason     String?          @db.VarChar(300)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, approverId])
  @@map("payout_approvals")
}

enum BulkBatchStatus {
  VALIDATED
  VALIDATION_FAILED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

model BulkPayoutBatch {
  id               String          @id
  merchantId       String          @map("merchant_id")
  fileName         String          @map("file_name") @db.VarChar(200)
  fileHash         String          @map("file_hash") @db.VarChar(64)
  status           BulkBatchStatus
  totalRows        Int             @map("total_rows")
  validRows        Int             @map("valid_rows")
  totalAmountMinor BigInt          @map("total_amount_minor")
  /// Approval tier applied to every row: the stricter of the batch total and the row amount.
  batchApprovals   Int             @default(0) @map("batch_approvals")
  createdCount     Int             @default(0) @map("created_count")
  failedCount      Int             @default(0) @map("failed_count")
  createdById      String?         @map("created_by_id")
  confirmedById    String?         @map("confirmed_by_id")
  confirmedAt      DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  rows BulkPayoutRow[]

  @@unique([merchantId, fileHash])
  @@index([merchantId, createdAt(sort: Desc)])
  @@map("bulk_payout_batches")
}

enum BulkRowStatus {
  VALID
  INVALID
  CREATED
  FAILED
}

/// A parsed CSV row. Holds a beneficiary reference, never the raw account number.
model BulkPayoutRow {
  id               String        @id
  batchId          String        @map("batch_id")
  rowNo            Int           @map("row_no")
  merchantOrderId  String?       @map("merchant_order_id") @db.VarChar(64)
  amountMinor      BigInt?       @map("amount_minor")
  mode             String?       @db.VarChar(10)
  purpose          String?       @db.VarChar(30)
  narration        String?       @db.VarChar(100)
  beneficiaryId    String?       @map("beneficiary_id")
  /// Masked display copy for the review screen.
  beneficiaryLabel String?       @map("beneficiary_label") @db.VarChar(200)
  status           BulkRowStatus
  errors           Json?
  payoutId         String?       @map("payout_id")

  batch BulkPayoutBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, rowNo])
  @@map("bulk_payout_rows")
}

// ------------------------------------------------------------------------------------------------
// Event pipeline & merchant webhooks (Phase 7) — docs/ARCHITECTURE.md §8, docs/WEBHOOKS.md
// ------------------------------------------------------------------------------------------------

/// Consumer idempotency: a row per (consumer group, event) inserted with the consumer's side effects.
model ProcessedEvent {
  consumerGroup String   @map("consumer_group") @db.VarChar(80)
  eventId       String   @map("event_id") @db.VarChar(60)
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumerGroup, eventId])
  @@index([processedAt])
  @@map("processed_events")
}

/// Messages a consumer gave up on after its retries (also published to `<topic>.dlq`).
model DeadLetterEvent {
  id            String    @id
  consumerGroup String    @map("consumer_group") @db.VarChar(80)
  topic         String    @db.VarChar(120)
  partition     Int
  offset        String    @db.VarChar(30)
  eventId       String?   @map("event_id") @db.VarChar(60)
  eventType     String?   @map("event_type") @db.VarChar(80)
  aggregateId   String?   @map("aggregate_id") @db.VarChar(60)
  error         String    @db.VarChar(1000)
  attempts      Int
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  requeuedAt    DateTime? @map("requeued_at") @db.Timestamptz(3)
  requeuedById  String?   @map("requeued_by_id")

  @@index([requeuedAt, createdAt])
  @@map("dead_letter_events")
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

model WebhookEndpoint {
  id                      String                @id
  merchantId              String                @map("merchant_id")
  url                     String                @db.VarChar(500)
  description             String?               @db.VarChar(200)
  /// Signing secret, encrypted (we must sign with it, so it can't be hashed). Shown once on creation/rotation.
  secretEncrypted         String                @map("secret_encrypted")
  secretHint              String                @map("secret_hint") @db.VarChar(20)
  /// After a rotation the old secret also signs deliveries until this time, so receivers can switch over.
  previousSecretEncrypted String?               @map("previous_secret_encrypted")
  previousSecretExpiresAt DateTime?             @map("previous_secret_expires_at") @db.Timestamptz(3)
  /// Subscribed event types; empty = all.
  events                  String[]              @default([])
  status                  WebhookEndpointStatus @default(ACTIVE)
  disabledReason          String?               @map("disabled_reason") @db.VarChar(300)
  consecutiveFailures     Int                   @default(0) @map("consecutive_failures")
  lastSuccessAt           DateTime?             @map("last_success_at") @db.Timestamptz(3)
  createdById             String?               @map("created_by_id")
  version                 Int                   @default(1)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([merchantId, status])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookDelivery {
  id             String                @id
  eventId        String                @map("event_id")
  endpointId     String                @map("endpoint_id")
  merchantId     String                @map("merchant_id")
  eventType      String                @map("event_type") @db.VarChar(60)
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error") @db.VarChar(500)
  lastAttemptAt  DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  endpoint    WebhookEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  attemptLogs WebhookDeliveryAttempt[]

  @@unique([eventId, endpointId])
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([endpointId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// One HTTP attempt. Response bodies are truncated and never include our signing secret.
model WebhookDeliveryAttempt {
  id              String   @id
  deliveryId      String   @map("delivery_id")
  attemptNo       Int      @map("attempt_no")
  statusCode      Int?     @map("status_code")
  durationMs      Int      @map("duration_ms")
  error           String?  @db.VarChar(500)
  responseSnippet String?  @map("response_snippet") @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, attemptNo])
  @@map("webhook_delivery_attempts")
}

// ------------------------------------------------------------------------------------------------
// Settlement & reconciliation (Phase 8) — docs/SETTLEMENT.md
// ------------------------------------------------------------------------------------------------

enum SettlementDestination {
  /// Credit the merchant's AVAILABLE balance (usable for payouts).
  WALLET
  /// Transfer to the merchant's verified settlement bank account.
  BANK
}

model SettlementConfig {
  merchantId     String                @id @map("merchant_id")
  cycle          SettlementCycle       @default(T1)
  /// Days after capture for CUSTOM (3–7).
  customDays     Int?                  @map("custom_days")
  /// Daily cutoff, minutes after IST midnight (default 18:00).
  cutoffMinute   Int                   @default(1080) @map("cutoff_minute")
  minAmountMinor BigInt                @default(100) @map("min_amount_minor")
  destination    SettlementDestination @default(BANK)
  autoSettle     Boolean               @default(true) @map("auto_settle")
  updatedById    String?               @map("updated_by_id")
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settlement_configs")
}

enum SettlementStatus {
  /// Bank transfer instructed, waiting for confirmation (funds in SETTLEMENT_CLEARING).
  PROCESSING
  /// Wallet credited, or bank transfer confirmed with a UTR.
  PROCESSED
  /// Bank transfer failed or was returned; funds went back to UNSETTLED.
  FAILED
}

model Settlement {
  id                String                @id
  merchantId        String                @map("merchant_id")
  resellerId        String?               @map("reseller_id")
  /// IST business date the settlement belongs to (one per merchant per date).
  settlementDate    String                @map("settlement_date") @db.Char(10)
  cycle             SettlementCycle
  destination       SettlementDestination
  periodStart       DateTime?             @map("period_start") @db.Timestamptz(3)
  /// Payments captured before this instant are included.
  periodEnd         DateTime              @map("period_end") @db.Timestamptz(3)
  status            SettlementStatus
  paymentCount      Int                   @map("payment_count")
  grossMinor        BigInt                @map("gross_minor")
  feeMinor          BigInt                @map("fee_minor")
  taxMinor          BigInt                @map("tax_minor")
  refundMinor       BigInt                @map("refund_minor")
  /// Amount actually moved out of UNSETTLED.
  netMinor          BigInt                @map("net_minor")
  bankAccountId     String?               @map("bank_account_id")
  /// Masked destination (account tail, IFSC, bank) — never the full number.
  bankSnapshot      Json?                 @map("bank_snapshot")
  utr               String?               @db.VarChar(40)
  bankReference     String?               @map("bank_reference") @db.VarChar(80)
  failureReason     String?               @map("failure_reason") @db.VarChar(300)
  journalId         String?               @map("journal_id")
  transferJournalId String?               @map("transfer_journal_id")
  paidJournalId     String?               @map("paid_journal_id")
  returnJournalId   String?               @map("return_journal_id")
  processedAt       DateTime?             @map("processed_at") @db.Timestamptz(3)
  processedById     String?               @map("processed_by_id")
  createdById       String?               @map("created_by_id")
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([merchantId, settlementDate])
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@map("settlements")
}

model SettlementHold {
  id            String    @id
  merchantId    String    @map("merchant_id")
  reason        String    @db.VarChar(300)
  placedById    String?   @map("placed_by_id")
  placedAt      DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  releasedById  String?   @map("released_by_id")
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)
  releaseReason String?   @map("release_reason") @db.VarChar(300)

  @@index([merchantId, releasedAt])
  @@map("settlement_holds")
}

/// Provider remittance to our bank (clears the provider clearing account; docs/LEDGER.md §4.2).
model ProviderRemittance {
  id          String   @id
  providerId  String   @map("provider_id")
  reference   String   @db.VarChar(80)
  valueDate   String   @map("value_date") @db.Char(10)
  amountMinor BigInt   @map("amount_minor")
  costMinor   BigInt   @map("cost_minor")
  bankRef     String   @map("bank_ref") @db.VarChar(40)
  journalId   String   @map("journal_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([providerId, reference])
  @@map("provider_remittances")
}

enum ReconKind {
  PAYIN
  PAYOUT
}

enum ReconRunStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model ReconciliationRun {
  id              String         @id
  providerId      String         @map("provider_id")
  kind            ReconKind
  fileName        String         @map("file_name") @db.VarChar(200)
  fileHash        String         @map("file_hash") @db.Char(64)
  storageKey      String         @map("storage_key") @db.VarChar(300)
  status          ReconRunStatus @default(QUEUED)
  periodFrom      DateTime?      @map("period_from") @db.Timestamptz(3)
  periodTo        DateTime?      @map("period_to") @db.Timestamptz(3)
  totalRows       Int            @default(0) @map("total_rows")
  matched         Int            @default(0)
  mismatched      Int            @default(0)
  missingInternal Int            @default(0) @map("missing_internal")
  missingProvider Int            @default(0) @map("missing_provider")
  duplicates      Int            @default(0)
  error           String?        @db.VarChar(1000)
  createdById     String?        @map("created_by_id")
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  entries ReconciliationEntry[]

  @@unique([providerId, fileHash])
  @@index([createdAt(sort: Desc)])
  @@map("reconciliation_runs")
}

enum ReconResult {
  MATCHED
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  MISSING_INTERNAL
  MISSING_PROVIDER
  DUPLICATE
}

enum ReconResolution {
  NOT_REQUIRED
  OPEN
  RESOLVED
}

model ReconciliationEntry {
  id                  String          @id
  runId               String          @map("run_id")
  lineNo              Int?            @map("line_no")
  result              ReconResult
  externalRef         String?         @map("external_ref") @db.VarChar(120)
  externalUtr         String?         @map("external_utr") @db.VarChar(40)
  externalAmountMinor BigInt?         @map("external_amount_minor")
  externalStatus      String?         @map("external_status") @db.VarChar(30)
  internalType        String?         @map("internal_type") @db.VarChar(10)
  internalId          String?         @map("internal_id")
  internalAmountMinor BigInt?         @map("internal_amount_minor")
  internalStatus      String?         @map("internal_status") @db.VarChar(30)
  resolution          ReconResolution
  resolutionNote      String?         @map("resolution_note") @db.VarChar(500)
  resolvedById        String?         @map("resolved_by_id")
  resolvedAt          DateTime?       @map("resolved_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, result])
  @@index([resolution, createdAt])
  @@index([internalId])
  @@map("reconciliation_entries")
}

// ------------------------------------------------------------------------------------------------
// Public API credentials, partners, commissions (Phase 9) — docs/API.md, docs/RESELLERS.md
// ------------------------------------------------------------------------------------------------

enum ApiEnvironment {
  TEST
  LIVE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

/// Server-to-server credential. The secret signs requests (HMAC), so it is stored encrypted (AAD =
/// key id), never hashed; it is shown once. Permissions are a subset of the creator's.
model ApiKey {
  id                 String         @id
  organizationId     String         @map("organization_id")
  environment        ApiEnvironment
  /// Public identifier sent as X-Pay2All-Key (pk_test_… / pk_live_…).
  publicKey          String         @unique @map("public_key") @db.VarChar(60)
  secretEncrypted    String         @map("secret_encrypted")
  secretLast4        String         @map("secret_last4") @db.Char(4)
  name               String         @db.VarChar(80)
  permissions        String[]
  status             ApiKeyStatus   @default(ACTIVE)
  /// Requests per minute for this key.
  rateLimitPerMinute Int            @default(600) @map("rate_limit_per_minute")
  /// Set on rotation: the old key keeps working until this time.
  expiresAt          DateTime?      @map("expires_at") @db.Timestamptz(3)
  lastUsedAt         DateTime?      @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp         String?        @map("last_used_ip") @db.VarChar(64)
  createdById        String?        @map("created_by_id")
  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedById        String?        @map("revoked_by_id")
  rotatedFromId      String?        @map("rotated_from_id")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, status])
  @@map("api_keys")
}

/// When an organization has entries for an environment, API calls are accepted only from these CIDRs.
model IpAllowlistEntry {
  id             String         @id
  organizationId String         @map("organization_id")
  environment    ApiEnvironment
  cidr           String         @db.VarChar(64)
  label          String?        @db.VarChar(80)
  createdById    String?        @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, environment, cidr])
  @@map("ip_allowlist_entries")
}

/// Dashboard sign-in allowlist (docs/SECURITY.md §1.8). Once an organization has entries, its users can
/// sign in and use the dashboard only from these addresses. The platform org's list covers all staff.
model DashboardIpRule {
  id             String   @id
  organizationId String   @map("organization_id")
  cidr           String   @db.VarChar(64)
  label          String?  @db.VarChar(80)
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, cidr])
  @@map("dashboard_ip_rules")
}

/// One row per API-key request (no bodies, no query strings). Purged after 90 days.
model ApiRequestLog {
  id             String   @id
  organizationId String   @map("organization_id")
  apiKeyId       String?  @map("api_key_id")
  /// Partner key acting for a merchant: the partner organization.
  partnerId      String?  @map("partner_id")
  method         String   @db.VarChar(8)
  path           String   @db.VarChar(200)
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  errorCode      String?  @map("error_code") @db.VarChar(60)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  requestId      String?  @map("request_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("api_request_logs")
}

/// Commission paid out to a reseller (Dr reseller COMMISSION_PAYABLE / Cr bank).
model CommissionPayout {
  id          String   @id
  resellerId  String   @map("reseller_id")
  amountMinor BigInt   @map("amount_minor")
  utr         String   @db.VarChar(40)
  periodNote  String?  @map("period_note") @db.VarChar(120)
  journalId   String   @map("journal_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([resellerId, utr])
  @@index([resellerId, createdAt(sort: Desc)])
  @@map("commission_payouts")
}

// ---- Risk (docs/RISK.md) ---------------------------------------------------------------------------

enum RiskRuleType {
  VELOCITY
  AMOUNT_ANOMALY
  NEW_MERCHANT_VOLUME
  BENEFICIARY_FAN_IN
  VOLUME_SPIKE
  FAILED_ATTEMPTS
  SHARED_BANK_ACCOUNT
}

enum RiskService {
  PAYIN
  PAYOUT
}

enum RiskActionType {
  ALLOW
  BLOCK
  MANUAL_REVIEW
  HOLD_SETTLEMENT
  DISABLE_PAYIN
  DISABLE_PAYOUT
}

enum RiskRuleMode {
  /// Record events and apply the action.
  ENFORCE
  /// Shadow mode: record what would have happened; take no action.
  MONITOR
}

enum RiskEventStatus {
  /// Recorded; no human decision needed.
  RECORDED
  /// Waiting in the manual review queue.
  OPEN
  /// Reviewed as a false positive: actions lifted, held payout released.
  CLEARED
  /// Reviewed as genuine risk: actions kept, held payout rejected.
  CONFIRMED
}

/// A configurable risk rule. Edits bump `version`; events keep the params they were evaluated with.
model RiskRule {
  id          String         @id
  code        String         @unique @db.VarChar(60)
  name        String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  type        RiskRuleType
  service     RiskService
  /// Type-specific thresholds, validated by riskRuleParamsSchema.
  params      Json
  action      RiskActionType
  mode        RiskRuleMode   @default(MONITOR)
  enabled     Boolean        @default(true)
  /// Lower runs first; only affects ordering in event lists (all matching rules are recorded).
  priority    Int            @default(100)
  version     Int            @default(1)
  updatedById String?        @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  events RiskEvent[]

  @@index([service, enabled])
  @@map("risk_rules")
}

/// One rule firing. `evidence` stores exactly why: observed values, thresholds and window.
model RiskEvent {
  id           String          @id
  ruleId       String          @map("rule_id")
  ruleCode     String          @map("rule_code") @db.VarChar(60)
  ruleVersion  Int             @map("rule_version")
  merchantId   String?         @map("merchant_id")
  /// What the rule fired on: PAYMENT, PAYOUT, MERCHANT or BENEFICIARY_ACCOUNT.
  subjectType  String          @map("subject_type") @db.VarChar(30)
  subjectId    String          @map("subject_id") @db.VarChar(80)
  action       RiskActionType
  mode         RiskRuleMode
  /// True when the action was actually applied (ENFORCE mode).
  enforced     Boolean
  reason       String          @db.VarChar(500)
  evidence     Json
  status       RiskEventStatus @default(RECORDED)
  /// Async rules: one event per rule/subject/window (prevents duplicate sweeps).
  dedupeKey    String?         @unique @map("dedupe_key") @db.VarChar(200)
  reviewedById String?         @map("reviewed_by_id")
  reviewedAt   DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewNote   String?         @map("review_note") @db.VarChar(500)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  rule    RiskRule           @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  actions RiskActionRecord[]

  @@index([status, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([ruleId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([subjectType, subjectId])
  @@map("risk_events")
}

/// A merchant-level control applied by an enforced risk event (hold, disable). Lifted by review.
model RiskActionRecord {
  id            String         @id
  eventId       String         @map("event_id")
  merchantId    String         @map("merchant_id")
  type          RiskActionType
  /// Settlement hold created for HOLD_SETTLEMENT.
  holdId        String?        @map("hold_id")
  /// DISABLE_*: whether the service was enabled before (only then is it re-enabled on lift).
  previousValue Boolean?       @map("previous_value")
  active        Boolean        @default(true)
  liftedById    String?        @map("lifted_by_id")
  liftedAt      DateTime?      @map("lifted_at") @db.Timestamptz(3)
  liftReason    String?        @map("lift_reason") @db.VarChar(300)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  event RiskEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([merchantId, active])
  @@index([active, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("risk_actions")
}

// ---- Report exports (docs/REPORTS.md) --------------------------------------------------------------

enum ReportType {
  PAYMENTS
  REFUNDS
  PAYOUTS
  SETTLEMENTS
  LOGIN_EVENTS
}

enum ReportFormat {
  CSV
  /// Reserved: the writer interface supports it; no implementation yet.
  XLSX
}

enum ReportExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

/// An asynchronous export. Generated by the jobs process in batches and streamed to object storage.
model ReportExport {
  id             String             @id
  /// Requesting organization (merchant, reseller/partner or platform).
  organizationId String             @map("organization_id")
  /// Tenant scope frozen at request time: PLATFORM, RESELLER or MERCHANT plus its id.
  scopeKind      String             @map("scope_kind") @db.VarChar(20)
  scopeId        String?            @map("scope_id")
  type           ReportType
  format         ReportFormat       @default(CSV)
  /// Validated filters (date range, status, merchant).
  filters        Json
  status         ReportExportStatus @default(QUEUED)
  rowCount       Int?               @map("row_count")
  fileSize       BigInt?            @map("file_size")
  sha256         String?            @db.Char(64)
  storageKey     String?            @map("storage_key") @db.VarChar(300)
  error          String?            @db.VarChar(300)
  attempts       Int                @default(0)
  requestedById  String?            @map("requested_by_id")
  /// Email the requester a download link when the file is ready.
  notifyByEmail  Boolean            @default(false) @map("notify_by_email")
  startedAt      DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(3)
  expiresAt      DateTime?          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("report_exports")
}

/// Running totals per merchant, service and IST period ("D2026-10-07" / "M2026-10") for daily and
/// monthly limits (docs/perf/INDEX_REVIEW.md §3). Incremented atomically — with the limit as the
/// update condition — in the transaction that creates the payin/payout; decremented when it fails,
/// expires or is rejected. Replaces per-request SUM() over the merchant's whole month.
model MerchantPeriodUsage {
  merchantId  String      @map("merchant_id")
  service     ServiceType
  period      String      @db.VarChar(11)
  amountMinor BigInt      @default(0) @map("amount_minor")
  count       Int         @default(0)
  updatedAt   DateTime    @map("updated_at") @db.Timestamptz(3)

  @@id([merchantId, service, period])
  @@index([updatedAt])
  @@map("merchant_period_usage")
}

// ---- API vendors (docs/VENDORS.md) -----------------------------------------------------------------

enum ApiVendorStatus {
  ACTIVE
  INACTIVE
}

/// A company Pay2All integrates with (a bank, an SMS gateway, an email service). Its payment
/// services are `providers` rows; its notification channels are `messaging_services` rows.
model ApiVendor {
  id           String          @id
  code         String          @unique @db.VarChar(40)
  name         String          @db.VarChar(120)
  status       ApiVendorStatus @default(ACTIVE)
  website      String?         @db.VarChar(300)
  contactEmail String?         @map("contact_email") @db.VarChar(254)
  notes        String?         @db.VarChar(1000)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  providers         Provider[]
  messagingServices MessagingService[]

  @@map("api_vendors")
}

enum MessagingServiceStatus {
  ACTIVE
  DISABLED
}

/// One notification channel offered by a vendor (sms21 SMS, sms21 WhatsApp, Amazon SES email).
/// Within a channel, ACTIVE services are tried in `priority` order (lower first) — the next one is
/// the fallback.
model MessagingService {
  id              String                 @id
  vendorId        String                 @map("vendor_id")
  channel         NotificationChannel
  /// Integration key: ses, smtp, sms21.
  adapter         String                 @db.VarChar(40)
  name            String                 @db.VarChar(120)
  status          MessagingServiceStatus @default(DISABLED)
  priority        Int                    @default(100)
  /// Non-secret settings validated per adapter (region, from address, base URL, template map).
  config          Json                   @default("{}")
  /// AES-256-GCM envelope of the adapter's secret JSON, AAD = messaging:<id>. Never returned.
  secretEncrypted String?                @map("secret_encrypted")
  /// Key names and last-4 fingerprints for display.
  fingerprints    Json                   @default("{}")
  lastSuccessAt   DateTime?              @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt   DateTime?              @map("last_failure_at") @db.Timestamptz(3)
  lastError       String?                @map("last_error") @db.VarChar(300)
  version         Int                    @default(1)
  updatedById     String?                @map("updated_by_id")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor ApiVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([channel, status, priority])
  @@index([vendorId])
  @@map("messaging_services")
}

// ---- Login activity -----------------------------------------------------------------------------------

enum LoginOutcome {
  SUCCESS
  /// Password accepted; waiting for the second factor.
  MFA_REQUIRED
  MFA_FAILED
  BAD_PASSWORD
  LOCKED
  DISABLED
  NOT_ACTIVATED
  NO_ACTIVE_ORGANIZATION
  UNKNOWN_USER
  /// Correct password, but the address is outside the organization's dashboard IP allowlist.
  IP_NOT_ALLOWED
}

/// One sign-in attempt (docs/SECURITY.md §1.6). Append-only. Location is the browser's own
/// geolocation, sent only when the user allowed it; never derived from IP by a third party.
model LoginEvent {
  id                String       @id
  userId            String?      @map("user_id")
  /// The organization the attempt signs into (null for unknown users / no membership).
  organizationId    String?      @map("organization_id")
  /// Masked email / mobile as typed (a***@x.com, 98******10).
  identifierMasked  String       @map("identifier_masked") @db.VarChar(254)
  outcome           LoginOutcome
  mfaUsed           Boolean      @default(false) @map("mfa_used")
  sessionId         String?      @map("session_id")
  ipAddress         String?      @map("ip_address") @db.VarChar(64)
  userAgent         String?      @map("user_agent") @db.VarChar(512)
  browser           String?      @db.VarChar(60)
  os                String?      @db.VarChar(60)
  deviceType        String?      @map("device_type") @db.VarChar(20)
  latitude          Decimal?     @db.Decimal(9, 6)
  longitude         Decimal?     @db.Decimal(9, 6)
  /// Browser-reported accuracy radius in metres.
  locationAccuracyM Int?         @map("location_accuracy_m")
  requestId         String?      @map("request_id") @db.VarChar(64)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("login_events")
}

// ---- In-app notifications (docs/NOTIFICATIONS.md) ------------------------------------------------------

enum InboxCategory {
  PAYMENT
  PAYOUT
  SETTLEMENT
  RISK
  SECURITY
  COMPLIANCE
  WEBHOOK
  REPORT
  SYSTEM
  WALLET
  DISPUTE
}

enum InboxSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

/// The bell: one row per recipient user (own read state). Inserting a row fires pg_notify via a
/// trigger, which Postgres delivers only on COMMIT; API nodes push it to open tabs over SSE.
model InboxNotification {
  id             String        @id
  userId         String        @map("user_id")
  organizationId String        @map("organization_id")
  category       InboxCategory
  severity       InboxSeverity @default(INFO)
  title          String        @db.VarChar(140)
  body           String        @db.VarChar(500)
  /// In-app path to open (e.g. /payout/transactions?payout=pout_…). Never an external URL.
  link           String?       @db.VarChar(300)
  resourceType   String?       @map("resource_type") @db.VarChar(40)
  resourceId     String?       @map("resource_id") @db.VarChar(80)
  /// Per-recipient idempotency (a retried producer never duplicates a notification).
  dedupeKey      String?       @map("dedupe_key") @db.VarChar(160)
  readAt         DateTime?     @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("inbox_notifications")
}

// ---- File storage ---------------------------------------------------------------------------------------

enum StorageKind {
  S3
  GOOGLE_DRIVE
  LOCAL
}

/// Where uploaded and generated files go (docs/FILE_STORAGE.md). One row per kind; at most one is
/// active for new files (partial unique index). With none active, the server's environment S3 is used.
model StorageBackend {
  id              String      @id
  kind            StorageKind @unique
  name            String      @db.VarChar(120)
  /// Non-secret settings validated per kind (bucket/region, Drive folder, local directory).
  config          Json        @default("{}")
  /// AES-256-GCM envelope of the kind's secret JSON, AAD = storage:<id>. Never returned.
  secretEncrypted String?     @map("secret_encrypted")
  /// Key names and last-4 fingerprints for display.
  fingerprints    Json        @default("{}")
  isActive        Boolean     @default(false) @map("is_active")
  lastTestedAt    DateTime?   @map("last_tested_at") @db.Timestamptz(3)
  lastTestOk      Boolean?    @map("last_test_ok")
  lastTestError   String?     @map("last_test_error") @db.VarChar(300)
  version         Int         @default(1)
  updatedById     String?     @map("updated_by_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  objects StorageObject[]

  @@map("storage_backends")
}

/// A file written through a configured backend: where it is and how to decrypt it. Keys without a
/// row live in the server's environment S3 (files written before backends existed).
model StorageObject {
  /// The application's object key (e.g. merchants/<id>/documents/<doc>.pdf).
  key         String   @id @db.VarChar(300)
  backendId   String   @map("backend_id")
  /// Backend-specific location: S3 object key, Google Drive file id, or path under the local root.
  locator     String   @db.VarChar(500)
  sizeBytes   BigInt   @map("size_bytes")
  contentType String   @map("content_type") @db.VarChar(120)
  sha256      String?  @db.VarChar(64)
  /// Per-file AES-256-GCM data key, wrapped by the platform key (AAD storage-object:<key>).
  wrappedKey  String   @map("wrapped_key") @db.VarChar(300)
  iv          String   @db.VarChar(32)
  authTag     String   @map("auth_tag") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  backend StorageBackend @relation(fields: [backendId], references: [id], onDelete: Restrict)

  @@index([backendId])
  @@map("storage_objects")
}

enum BrandAssetKind {
  /// Full logo for light backgrounds.
  LOGO
  /// Full logo for dark backgrounds (sidebar, sign-in panel, dark mode).
  LOGO_DARK
  /// Square mark: favicon and compact places.
  ICON
}

/// White-label brand (single row, id = 'default'; docs/BRANDING.md). Missing = built-in defaults.
model BrandSettings {
  id            String   @id @default("default") @db.VarChar(20)
  productName   String   @map("product_name") @db.VarChar(60)
  shortName     String   @map("short_name") @db.VarChar(30)
  companyName   String   @map("company_name") @db.VarChar(160)
  tagline       String   @db.VarChar(160)
  /// #RRGGBB; null = the built-in theme colour.
  primaryColor  String?  @map("primary_color") @db.Char(7)
  supportEmail  String?  @map("support_email") @db.VarChar(254)
  supportPhone  String?  @map("support_phone") @db.VarChar(20)
  websiteUrl    String?  @map("website_url") @db.VarChar(300)
  loginHeadline String   @map("login_headline") @db.VarChar(120)
  loginSubtext  String   @map("login_subtext") @db.VarChar(300)
  footerText    String?  @map("footer_text") @db.VarChar(200)
  version       Int      @default(1)
  updatedById   String?  @map("updated_by_id")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brand_settings")
}

/// Uploaded brand images, served publicly by GET /v1/brand/assets/:kind (small; kept in the database).
model BrandAsset {
  kind        BrandAssetKind @id
  contentType String         @map("content_type") @db.VarChar(40)
  bytes       Bytes
  sizeBytes   Int            @map("size_bytes")
  sha256      String         @db.Char(64)
  width       Int?
  height      Int?
  updatedById String?        @map("updated_by_id")
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brand_assets")
}

enum CollectionAccountKind {
  BANK
  UPI
}

/// Where merchants send money to load their wallet (docs/FUND_REQUESTS.md). Managed by super admins.
model CollectionAccount {
  id                     String                @id
  kind                   CollectionAccountKind
  label                  String                @db.VarChar(80)
  accountHolder          String?               @map("account_holder") @db.VarChar(120)
  /// AES-256-GCM, AAD = collection-account:<id>. Shown in full only to merchants loading funds.
  accountNumberEncrypted String?               @map("account_number_encrypted")
  accountNumberLast4     String?               @map("account_number_last4") @db.Char(4)
  ifsc                   String?               @db.Char(11)
  bankName               String?               @map("bank_name") @db.VarChar(80)
  branch                 String?               @db.VarChar(120)
  accountType            String?               @map("account_type") @db.VarChar(10)
  upiId                  String?               @map("upi_id") @db.VarChar(100)
  payeeName              String?               @map("payee_name") @db.VarChar(100)
  minAmountMinor         BigInt?               @map("min_amount_minor")
  maxAmountMinor         BigInt?               @map("max_amount_minor")
  instructions           String?               @db.VarChar(300)
  isActive               Boolean               @default(true) @map("is_active")
  sortOrder              Int                   @default(100) @map("sort_order")
  version                Int                   @default(1)
  createdById            String?               @map("created_by_id")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests         FundRequest[]
  statementImports StatementImport[]

  @@index([isActive, sortOrder])
  @@map("collection_accounts")
}

enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A merchant's claim that it paid into a collection account; approval credits its AVAILABLE balance.
model FundRequest {
  id                  String            @id
  merchantId          String            @map("merchant_id")
  collectionAccountId String            @map("collection_account_id")
  amountMinor         BigInt            @map("amount_minor")
  /// UPI / IMPS / NEFT / RTGS / CASH_DEPOSIT / OTHER
  mode                String            @db.VarChar(20)
  /// Bank or UPI reference, upper-cased. Unique for ever: one UTR can be claimed once, whatever happens to the claim.
  utr                 String            @unique @db.VarChar(30)
  paidAt              DateTime          @map("paid_at") @db.Timestamptz(3)
  remarks             String?           @db.VarChar(300)
  /// Optional payment screenshot in file storage (encrypted like every stored file).
  proofKey            String?           @map("proof_key") @db.VarChar(300)
  proofName           String?           @map("proof_name") @db.VarChar(160)
  proofType           String?           @map("proof_type") @db.VarChar(40)
  status              FundRequestStatus @default(PENDING)
  /// What was actually credited (an approver may correct it to the amount the bank shows).
  creditedAmountMinor BigInt?           @map("credited_amount_minor")
  decidedById         String?           @map("decided_by_id")
  decidedAt           DateTime?         @map("decided_at") @db.Timestamptz(3)
  decisionNote        String?           @map("decision_note") @db.VarChar(300)
  journalId           String?           @unique @map("journal_id")
  createdById         String            @map("created_by_id")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  collectionAccount CollectionAccount @relation(fields: [collectionAccountId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@map("fund_requests")
}

enum StatementLineStatus {
  /// Matched to a pending fund request with the same UTR and amount; the request was approved.
  MATCHED
  /// A fund request with this UTR exists but the amount differs: approve or reject by hand.
  AMOUNT_MISMATCH
  /// The fund request for this UTR was already decided before the statement arrived.
  ALREADY_DECIDED
  /// No fund request yet; a later request with this UTR and amount is approved automatically.
  UNMATCHED
}

/// One uploaded bank statement for a collection account (docs/FUND_REQUESTS.md §6).
model StatementImport {
  id                  String   @id
  collectionAccountId String   @map("collection_account_id")
  fileName            String   @map("file_name") @db.VarChar(160)
  /// SHA-256 of the file: the same file can't be imported twice for an account.
  fileSha256          String   @map("file_sha256") @db.Char(64)
  credits             Int
  matched             Int
  mismatched          Int
  unmatched           Int
  alreadyDecided      Int      @map("already_decided")
  duplicates          Int
  uploadedById        String   @map("uploaded_by_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  collectionAccount CollectionAccount @relation(fields: [collectionAccountId], references: [id], onDelete: Restrict)
  lines             StatementLine[]

  @@unique([collectionAccountId, fileSha256])
  @@index([createdAt(sort: Desc)])
  @@map("statement_imports")
}

/// A credit on a bank statement. A UTR is used once per account across all imports.
model StatementLine {
  id                  String              @id
  importId            String              @map("import_id")
  collectionAccountId String              @map("collection_account_id")
  lineNo              Int                 @map("line_no")
  valueDate           DateTime?           @map("value_date") @db.Timestamptz(3)
  description         String              @db.VarChar(300)
  amountMinor         BigInt              @map("amount_minor")
  /// The reference this line was matched or recorded under (null: no usable reference).
  utr                 String?             @db.VarChar(30)
  /// Every reference candidate read from the line (reference column and narration).
  references          String[]            @default([])
  status              StatementLineStatus
  fundRequestId       String?             @unique @map("fund_request_id")
  matchedAt           DateTime?           @map("matched_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  import StatementImport @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([collectionAccountId, utr])
  @@index([importId, lineNo])
  @@index([collectionAccountId, status])
  @@map("statement_lines")
}

enum DisputeStatus {
  /// Opened; the merchant can add evidence until respond_by.
  OPEN
  /// Merchant submitted evidence (or the deadline passed); waiting for the bank / network.
  UNDER_REVIEW
  /// Decided for the merchant: the lien is released.
  WON
  /// Decided for the customer: the amount (and any chargeback fee) is debited.
  LOST
}

/// A customer dispute / chargeback on a captured payment (docs/DISPUTES.md). Money is frozen in the
/// merchant's LIEN bucket while it is open (CHARGEBACK_LIEN), then released or debited.
model Dispute {
  id                  String        @id
  paymentId           String        @map("payment_id")
  merchantId          String        @map("merchant_id")
  /// The bank / network's case number, when known.
  providerCaseId      String?       @map("provider_case_id") @db.VarChar(80)
  reasonCode          String        @map("reason_code") @db.VarChar(40)
  reason              String        @db.VarChar(500)
  amountMinor         BigInt        @map("amount_minor")
  status              DisputeStatus @default(OPEN)
  respondBy           DateTime      @map("respond_by") @db.Timestamptz(3)
  /// The payment's status before the dispute (restored when it is won).
  paymentStatusBefore PaymentStatus @map("payment_status_before")
  /// Where the lien came from: { available, unsettled, receivable } in paise (as strings).
  lienSources         Json          @map("lien_sources")
  lienJournalId       String        @unique @map("lien_journal_id")
  outcomeJournalId    String?       @unique @map("outcome_journal_id")
  feeMinor            BigInt        @default(0) @map("fee_minor")
  taxMinor            BigInt        @default(0) @map("tax_minor")
  merchantNote        String?       @map("merchant_note") @db.VarChar(2000)
  submittedAt         DateTime?     @map("submitted_at") @db.Timestamptz(3)
  /// The merchant accepted the dispute instead of contesting it.
  accepted            Boolean       @default(false)
  resolutionNote      String?       @map("resolution_note") @db.VarChar(500)
  resolvedById        String?       @map("resolved_by_id")
  resolvedAt          DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdById         String        @map("created_by_id")
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  evidence DisputeEvidence[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status, respondBy])
  @@index([paymentId])
  @@map("disputes")
}

/// A file the merchant uploaded for a dispute (stored encrypted like every file).
model DisputeEvidence {
  id           String   @id
  disputeId    String   @map("dispute_id")
  storageKey   String   @map("storage_key") @db.VarChar(300)
  fileName     String   @map("file_name") @db.VarChar(160)
  contentType  String   @map("content_type") @db.VarChar(40)
  sizeBytes    Int      @map("size_bytes")
  sha256       String   @db.Char(64)
  description  String?  @db.VarChar(300)
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
  @@map("dispute_evidence")
}

/// The platform's GST registration, printed on every tax invoice (single row, id "default").
model TaxProfile {
  id            String   @id @default("default")
  legalName     String   @map("legal_name") @db.VarChar(200)
  gstin         String   @db.Char(15)
  pan           String   @db.Char(10)
  address       String   @db.VarChar(400)
  stateCode     String   @map("state_code") @db.Char(2)
  sac           String   @db.VarChar(8)
  invoicePrefix String   @map("invoice_prefix") @db.VarChar(5)
  footerNote    String?  @map("footer_note") @db.VarChar(500)
  updatedById   String?  @map("updated_by_id")
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tax_profile")
}

/// Gapless invoice serials per financial year (GST rule 46: consecutive, unique per FY).
model InvoiceSequence {
  financialYear String @id @map("financial_year") @db.VarChar(7)
  lastSerial    Int    @default(0) @map("last_serial")

  @@map("invoice_sequences")
}

/// A monthly GST tax invoice to a merchant for platform fees (docs/INVOICES.md). Immutable once issued.
model Invoice {
  id              String   @id
  merchantId      String   @map("merchant_id")
  number          String   @unique @db.VarChar(16)
  financialYear   String   @map("financial_year") @db.VarChar(7)
  /// The invoiced month (IST): [periodStart, periodEnd).
  periodStart     DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd       DateTime @map("period_end") @db.Timestamptz(3)
  issueDate       DateTime @map("issue_date") @db.Timestamptz(3)
  /// Supplier (platform) and recipient (merchant) as they were at issue.
  seller          Json
  buyer           Json
  placeOfSupply   String?  @map("place_of_supply") @db.Char(2)
  interState      Boolean  @map("inter_state")
  /// [{ code, description, sac, count, taxable_minor, tax_minor }] as strings.
  lines           Json
  taxableMinor    BigInt   @map("taxable_minor")
  cgstMinor       BigInt   @map("cgst_minor")
  sgstMinor       BigInt   @map("sgst_minor")
  igstMinor       BigInt   @map("igst_minor")
  totalMinor      BigInt   @map("total_minor")
  /// For the merchant's reference: scheme commission credited in the month (not part of the invoice).
  commissionMinor BigInt   @map("commission_minor")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([merchantId, periodStart])
  @@index([periodStart, merchantId])
  @@map("invoices")
}

enum WebsiteStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A merchant's website: checkout sends customers back only to approved ones (docs/CHECKOUT.md).
model MerchantWebsite {
  id           String        @id
  merchantId   String        @map("merchant_id")
  /// Origin only: scheme://host[:port].
  url          String        @db.VarChar(300)
  label        String?       @db.VarChar(80)
  status       WebsiteStatus @default(PENDING)
  reviewNote   String?       @map("review_note") @db.VarChar(300)
  reviewedById String?       @map("reviewed_by_id")
  reviewedAt   DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions CheckoutSession[]

  @@unique([merchantId, url])
  @@index([status, createdAt])
  @@map("merchant_websites")
}

enum CheckoutSessionStatus {
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

/// A hosted checkout page for one order. Payments are attempts of it.
/// What a checkout session was created for (docs/PAYMENT_LINKS.md).
enum CheckoutKind {
  /// API checkout for an order on the merchant's website (returns to return_url).
  CHECKOUT
  /// One-off payment link shared by the merchant (no website; ends on a receipt).
  LINK
  /// A payment made through a reusable payment page.
  PAGE
}

model CheckoutSession {
  id              String                @id
  merchantId      String                @map("merchant_id")
  kind            CheckoutKind          @default(CHECKOUT)
  /// Unguessable public handle used in the checkout URL (never the id).
  token           String                @unique @db.VarChar(64)
  merchantOrderId String                @map("merchant_order_id") @db.VarChar(60)
  amountMinor     BigInt                @map("amount_minor")
  description     String?               @db.VarChar(200)
  customerName    String?               @map("customer_name") @db.VarChar(120)
  customerEmail   String?               @map("customer_email") @db.VarChar(254)
  customerMobile  String?               @map("customer_mobile") @db.VarChar(15)
  /// CHECKOUT only: where the customer returns (on an approved website).
  returnUrl       String?               @map("return_url") @db.VarChar(500)
  websiteId       String?               @map("website_id")
  /// PAGE only: the payment page it was paid through.
  pageId          String?               @map("page_id")
  status          CheckoutSessionStatus @default(OPEN)
  /// The successful payment.
  paymentId       String?               @unique @map("payment_id")
  attempts        Int                   @default(0)
  metadata        Json                  @default("{}")
  /// LINK: last time the link was sent to the customer (email/SMS).
  notifiedAt      DateTime?             @map("notified_at") @db.Timestamptz(3)
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(3)
  paidAt          DateTime?             @map("paid_at") @db.Timestamptz(3)
  createdById     String?               @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  website MerchantWebsite? @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  page    PaymentPage?     @relation(fields: [pageId], references: [id], onDelete: Restrict)

  @@unique([merchantId, merchantOrderId])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, kind, createdAt(sort: Desc)])
  @@index([pageId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

enum PaymentPageStatus {
  ACTIVE
  INACTIVE
}

enum PaymentPageAmountType {
  /// Every customer pays `amountMinor`.
  FIXED
  /// The customer enters an amount between min and max.
  CUSTOMER
}

/// A reusable public page (/p/<slug>) where many customers pay: fees, donations, events, products.
model PaymentPage {
  id             String                @id
  merchantId     String                @map("merchant_id")
  slug           String                @unique @db.VarChar(60)
  title          String                @db.VarChar(120)
  description    String?               @db.VarChar(1000)
  amountType     PaymentPageAmountType @map("amount_type")
  amountMinor    BigInt?               @map("amount_minor")
  minAmountMinor BigInt?               @map("min_amount_minor")
  maxAmountMinor BigInt?               @map("max_amount_minor")
  /// Up to 5 extra fields shown to the payer: [{ key, label, type: text|number|email|phone, required }].
  fields         Json                  @default("[]")
  successMessage String?               @map("success_message") @db.VarChar(300)
  status         PaymentPageStatus     @default(ACTIVE)
  createdById    String?               @map("created_by_id")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions CheckoutSession[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("payment_pages")
}

enum StaticQrStatus {
  ACTIVE
  CLOSED
}

/// A merchant's static (printable) UPI QR issued by a provider. Customers pay any amount; each credit
/// the provider reports becomes a captured payment (docs/STATIC_QR.md).
model StaticQr {
  id           String         @id
  merchantId   String         @map("merchant_id")
  providerId   String         @map("provider_id")
  providerQrId String         @map("provider_qr_id") @db.VarChar(120)
  label        String         @db.VarChar(80)
  /// The UPI string encoded in the QR (upi://pay?pa=…), without an amount, when the provider gives it.
  upiPayload   String?        @map("upi_payload") @db.VarChar(1000)
  /// The provider's hosted QR image, when it gives an image instead of (or as well as) the string.
  imageUrl     String?        @map("image_url") @db.VarChar(500)
  status       StaticQrStatus @default(ACTIVE)
  lastCreditAt DateTime?      @map("last_credit_at") @db.Timestamptz(3)
  /// Reconciliation poll watermark (credits missed by webhooks are picked up by the poller).
  lastPolledAt DateTime?      @map("last_polled_at") @db.Timestamptz(3)
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz(3)

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([providerId, providerQrId])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status, lastPolledAt])
  @@map("static_qrs")
}
