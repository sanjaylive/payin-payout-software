{
  "name": "@pay2all/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --no-file-parallelism"
  },
  "dependencies": {
    "@pay2all/auth": "workspace:*",
    "@pay2all/config": "workspace:*",
    "@pay2all/database": "workspace:*",
    "@pay2all/events": "workspace:*",
    "@pay2all/logger": "workspace:*",
    "@pay2all/providers": "workspace:*",
    "@pay2all/telemetry": "workspace:*",
    "dotenv": "^17.2.3",
    "ioredis": "^5.11.1",
    "kafkajs": "2.2.4",
    "nodemailer": "^10.0.15",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
