{
  "name": "@pay2all/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync-rbac": "tsx prisma/sync-rbac.ts"
  },
  "dependencies": {
    "@pay2all/auth": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.3",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@pay2all/config": "workspace:*",
    "@pay2all/validation": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
