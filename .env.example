# ---------------------------------------------------------------------------
# Pay2All Payments — example environment. Copy to `.env` and fill real values.
# NEVER commit real secrets. Every secret below is a placeholder.
# Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API -------------------------------------------------------------------
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API (for client IP resolution).
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
SWAGGER_ENABLED=true

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgresql://pay2all:pay2all_dev_only@localhost:55432/pay2all?schema=public
TEST_DATABASE_URL=postgresql://pay2all:pay2all_dev_only@localhost:55432/pay2all_test?schema=public
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:56379
KAFKA_BROKERS=localhost:59092
KAFKA_CLIENT_ID=pay2all

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes-base64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-byte-secret
REFRESH_TOKEN_TTL_SECONDS=1209600
# Cookie domain for the refresh-token cookie (blank = host-only cookie).
AUTH_COOKIE_DOMAIN=
# Require TOTP MFA for roles flagged requiresMfa (SUPER_ADMIN, ADMIN, FINANCE, COMPLIANCE ...).
AUTH_ENFORCE_MFA=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900

# --- Encryption ------------------------------------------------------------
# 32-byte key, base64 encoded (openssl rand -base64 32). Used for AES-256-GCM
# field encryption (MFA secrets, provider credentials, bank account numbers).
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ENCRYPTION_KEY_ID=k1

# --- Object storage (S3 compatible) ---------------------------------------
S3_ENDPOINT=http://localhost:58333
S3_REGION=ap-south-1
S3_BUCKET=pay2all-documents
S3_ACCESS_KEY=pay2all
S3_SECRET_KEY=replace-me-dev-value-is-pay2all_dev_only
S3_FORCE_PATH_STYLE=true
# Server-side encryption for uploads (required in production, e.g. AES256 or aws:kms).
S3_SSE=
MAX_DOCUMENT_BYTES=10485760

# --- Notifications ---------------------------------------------------------
SMTP_URL=smtp://localhost:51025
MAIL_FROM="Pay2All Payments <no-reply@pay2all.local>"

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web (Next.js) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
